# ClinicalConnect Environment Configuration Template
# Duplicate this file to .env and configure your local environment credentials.
# NOTE: .env is excluded from git version control.

# PostgreSQL Connection Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clinicalconnect
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DATABASE_URL=postgresql://postgres:your_secure_password_here@127.0.0.1:5432/clinicalconnect

# Server & Security
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_entropy_secret_key_minimum_32_characters
JWT_EXPIRATION=7d

# Audit & Diagnostics
HIPAA_AUDIT_ENABLED=true
